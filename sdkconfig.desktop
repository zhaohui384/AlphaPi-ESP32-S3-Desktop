CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI=y
CONFIG_LANGUAGE_ZH_CN=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/desktop.csv"
CONFIG_FLASH_NONE_ASSETS=y
CONFIG_USE_WAKE_WORD_DETECT=n
CONFIG_USE_WAKE_WORD_CUSTOM=n
CONFIG_USE_AUDIO_PROCESSOR=n
CONFIG_USE_SERVER_AEC=n
CONFIG_USE_DEVICE_AEC=n
CONFIG_LV_MEM_SIZE_KILOBYTES=128

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_WAKE_WORD_DISABLED=y
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
